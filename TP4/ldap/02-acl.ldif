dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to *
  by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage
  by * break
olcAccess: {1}to attrs=userPassword
  by anonymous auth
  by * none
olcAccess: {2}to dn.subtree="ou=people,dc=polycorp,dc=com"
  by dn.exact="cn=svc-keycloak,ou=services,dc=polycorp,dc=com" read
  by * none
olcAccess: {3}to dn.subtree="ou=groups,dc=polycorp,dc=com"
  by dn.exact="cn=svc-keycloak,ou=services,dc=polycorp,dc=com" read
  by * none
olcAccess: {4}to *
  by * none
